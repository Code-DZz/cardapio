            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .form-field {
            margin-bottom: 32px;
        }

        .field-label {
            display: block;
            font-size: 14px;
            font-weight: 800;
            margin-bottom: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--light-text);
        }

        body.dark-mode .field-label {
            color: var(--dark-text);
        }

        .field-input {
            width: 100%;
            padding: 18px 20px;
            border: 2px solid var(--border-color);
            border-radius: 14px;
            font-size: 16px;
            font-family: inherit;
            transition: all 0.3s ease;
            background: var(--light-surface);
            color: var(--light-text);
