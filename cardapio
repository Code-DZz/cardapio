                { code: 'LANCHE20', discount: 0.20, type: 'percentage', minValue: 40 }
            ],
            
            applyPromo(code, cartTotal) {
                const promo = this.activePromos.find(p => p.code === code.toUpperCase());
                
                if (!promo) return { valid: false, message: 'Cupom inválido' };
                if (cartTotal < promo.minValue) {
                    return { 
                        valid: false, 
                        message: `Mínimo de R$ ${promo.minValue.toFixed(2)} para este cupom` 
                    };
                }
                
                const discount = promo.type === 'percentage' 
                    ? cartTotal * promo.discount 
                    : promo.discount;
                
                return {
                    valid: true,
                    discount,
                    newTotal: cartTotal - discount,
                    promoName: promo.code
                };
            }
