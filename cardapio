        // Lidar com checkout - VERSÃO CORRIGIDA
        async function handleCheckout(e) {
            e.preventDefault();
            
            console.log("Checkout iniciado...");
            
            // Verificar horário
            const hours = checkBusinessHours();
            if (!hours.isOpen) {
                alert(`⏰ ${hours.message}`);
                return;
            }
            
            if (shoppingCart.length === 0) {
                alert("🛒 Seu carrinho está vazio!");
                return;
            }
            
            // Coletar dados do formulário
            const customerName = document.getElementById('custName').value.trim();
            const customerPhone = document.getElementById('custPhone').value.trim();
            const customerAddress = document.getElementById('custAddress').value.trim();
            const paymentMethod = document.getElementById('paymentMethod').value;
            const changeAmount = document.getElementById('changeAmount').value.trim();
            const orderNotes = document.getElementById('orderNotes').value.trim();
            const deliveryType = document.querySelector('.delivery-choice.selected').dataset.delivery;
            
            // Validações básicas
            if (!customerName || !customerPhone || !customerAddress || !paymentMethod) {
                alert('⚠️ Preencha todos os campos obrigatórios!');
                return;
            }
            
            // Validar telefone (regex mais flexível)
            const phoneRegex = /^(\+55\s?)?(\(?\d{2}\)?[\s-]?)?\d{4,5}[\s-]?\d{4}$/;
            if (!phoneRegex.test(customerPhone.replace(/\s+/g, ''))) {
                alert('📱 Digite um telefone válido! Ex: (11) 99999-9999');
                return;
            }
            
            showLoading(true);
            
            try {
                // Gerar código do pedido
                generateOrderCode();
                
                // Calcular totais
                const subtotal = shoppingCart.reduce((sum, item) => sum + (item.finalPrice * item.qty), 0);
                const deliveryFee = 8.00;
                const discount = appliedPromo?.discount || 0;
                const total = Math.max(0, subtotal + deliveryFee - discount);
                
                // Construir mensagem do WhatsApp
                const whatsappMessage = buildWhatsAppText({
                    orderCode: currentOrderCode,
                    customerName,
                    customerPhone,
                    customerAddress,
                    paymentMethod,
                    changeAmount,
                    orderNotes,
                    deliveryType,
                    items: shoppingCart,
                    appliedPromo,
                    subtotal,
                    deliveryFee,
                    discount,
                    total
                });
                
                console.log("Mensagem WhatsApp construída");
                
                // Enviar para WhatsApp
                const config = window.elementSdk?.config || defaultConfig;
                const whatsappNum = (config.whatsapp_number || defaultConfig.whatsapp_number)
                    .replace(/\D/g, '');
                
                console.log("Número WhatsApp:", whatsappNum);
                
                const whatsappLink = `https://wa.me/${whatsappNum}?text=${encodeURIComponent(whatsappMessage)}`;
                
                // Salvar dados localmente
                saveFormData();
                
                // Salvar pedido no histórico
                const orderData = {
                    id: Date.now().toString(),
                    order_code: currentOrderCode,
                    items: shoppingCart,
                    customer_name: customerName,
                    customer_phone: customerPhone,
                    customer_address: customerAddress,
                    payment_method: paymentMethod,
                    delivery_type: deliveryType,
                    subtotal: subtotal,
                    delivery_fee: deliveryFee,
                    discount: discount,
                    total: total,
                    timestamp: new Date().toISOString(),
                    status: 'pendente'
                };
                
                // Salvar no localStorage para histórico
                saveOrderToHistory(orderData);
                
                // Limpar carrinho
                shoppingCart = [];
                appliedPromo = null;
                updateCartBadge();
                saveCartToStorage();
                
                // Resetar formulário
                document.getElementById('checkoutForm').reset();
                document.getElementById('promoCode').value = '';
                document.getElementById('promoMessage').textContent = '';
                
                showLoading(false);
                
                // Navegar para confirmação
                navigateTo('confirmation');
                
                // Atualizar código do pedido na confirmação
                document.getElementById('orderCodeDisplay').textContent = currentOrderCode;
                
                // Abrir WhatsApp após 1 segundo
                setTimeout(() => {
                    window.open(whatsappLink, '_blank', 'noopener,noreferrer');
                }, 1000);
                
            } catch (error) {
                console.error('Erro no checkout:', error);
                showLoading(false);
                alert('❌ Ocorreu um erro ao processar seu pedido. Tente novamente.');
            }
        }

        // Função para salvar pedido no histórico
        function saveOrderToHistory(orderData) {
            try {
                const orders = JSON.parse(localStorage.getItem('orderHistory') || '[]');
                orders.push(orderData);
                localStorage.setItem('orderHistory', JSON.stringify(orders));
            } catch (e) {
                console.warn('Não foi possível salvar histórico:', e);
            }
        }

        // Construir mensagem do WhatsApp - VERSÃO CORRIGIDA
        function buildWhatsAppText(orderData) {
            let msg = `*🍔 NOVO PEDIDO - ${defaultConfig.restaurant_name}*\n\n`;
            msg += `*Código:* ${orderData.orderCode}\n`;
            msg += `*Data:* ${new Date().toLocaleDateString('pt-BR')}\n`;
            msg += `*Hora:* ${new Date().toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'})}\n\n`;
            
            msg += `*👤 CLIENTE*\n`;
            msg += `Nome: ${orderData.customerName}\n`;
            msg += `Telefone: ${orderData.customerPhone}\n`;
            msg += `Endereço: ${orderData.customerAddress}\n`;
            msg += `Tipo: ${orderData.deliveryType === 'delivery' ? '🚚 Entrega' : '🏪 Retirada'}\n\n`;
            
            msg += `*📦 ITENS DO PEDIDO*\n`;
            orderData.items.forEach((item, index) => {
                msg += `\n${index + 1}. ${item.qty}x *${item.name}*\n`;
                if (item.customizations && item.customizations !== 'Tamanho: M') {
                    msg += `   ${item.customizations}\n`;
                }
                msg += `   R$ ${(item.finalPrice * item.qty).toFixed(2)}\n`;
            });
            
            msg += `\n*💰 RESUMO DO VALOR*\n`;
            msg += `Subtotal: R$ ${orderData.subtotal.toFixed(2)}\n`;
            msg += `Taxa de Entrega: R$ ${orderData.deliveryFee.toFixed(2)}\n`;
            if (orderData.discount > 0) {
                msg += `Desconto: -R$ ${orderData.discount.toFixed(2)}\n`;
            }
            msg += `*TOTAL: R$ ${orderData.total.toFixed(2)}*\n\n`;
            
            msg += `*💳 PAGAMENTO*\n`;
            msg += `Forma: ${orderData.paymentMethod}\n`;
            if (orderData.changeAmount) {
                msg += `Troco para: ${orderData.changeAmount}\n`;
            }
            
            if (orderData.orderNotes) {
                msg += `\n*📝 OBSERVAÇÕES*\n${orderData.orderNotes}\n`;
            }
            
            msg += `\n_Obrigado por seu pedido!_\n`;
            msg += `_Tempo estimado: 30-45 minutos_`;
            
            return msg;
        }

        // ========== FUNÇÕES EXISTENTES (mantidas) ==========

        // Inicialização da aplicação
