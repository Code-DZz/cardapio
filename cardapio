        // Selecionar tamanho
        function selectSize(size) {
            customizationState.size = size;
            document.querySelectorAll('.size-choice').forEach(el => {
                el.classList.remove('selected');
            });
            document.querySelector(`[data-size="${size}"]`).classList.add('selected');
            updateCustomizationTotal();
        }

        // Ajustar quantidade
        function adjustQuantity(type, index, delta) {
            const key = type === 'ingredient' ? 'ingredients' : 'addons';
            const current = customizationState[key][index] || 0;
            const newValue = Math.max(0, current + delta);
            
            customizationState[key][index] = newValue;
            document.getElementById(`${type === 'ingredient' ? 'ing' : 'add'}-${index}`).textContent = newValue;
            
            updateCustomizationTotal();
        }

        // Atualizar total da personalização
        function updateCustomizationTotal() {
            if (!selectedProduct) return;

            let total = selectedProduct.price;

            Object.keys(customizationState.ingredients).forEach(idx => {
                const qty = customizationState.ingredients[idx];
                total += ingredientsList[idx].price * qty;
            });

            Object.keys(customizationState.addons).forEach(idx => {
                const qty = customizationState.addons[idx];
                total += addonsList[idx].price * qty;
            });

            document.getElementById('showcasePrice').textContent = `R$ ${total.toFixed(2)}`;
            document.getElementById('addCartBtn').textContent = 
                `Adicionar ao Carrinho - R$ ${total.toFixed(2)}`;
        }

        // Adicionar item ao carrinho
        function addItemToCart() {
            if (!selectedProduct) return;

            let totalPrice = selectedProduct.price;
            const customsList = [`Tamanho: ${customizationState.size}`];

            // Calcular ingredientes extras
            Object.keys(customizationState.ingredients).forEach(idx => {
                const qty = customizationState.ingredients[idx];
                if (qty > 0) {
                    totalPrice += ingredientsList[idx].price * qty;
                    customsList.push(`${ingredientsList[idx].name} (${qty}x)`);
                }
            });

            // Calcular adicionais
            Object.keys(customizationState.addons).forEach(idx => {
                const qty = customizationState.addons[idx];
                if (qty > 0) {
                    totalPrice += addonsList[idx].price * qty;
                    customsList.push(`${addonsList[idx].name} (${qty}x)`);
                }
            });

            // Adicionar ao carrinho
            shoppingCart.push({
                ...selectedProduct,
                customizations: customsList.join(', '),
                finalPrice: totalPrice,
                qty: 1
            });

            // Atualizar badge e salvar
            updateCartBadge();
            saveCartToStorage();
            
            navigateTo('cart');
        }

        // Renderizar itens do carrinho
        function renderCartItems() {
            const container = document.getElementById('cartList');
            
            if (shoppingCart.length === 0) {
                container.innerHTML = `
                    <div class="empty-view">
                        <div class="empty-icon">🛒</div>
                        <div class="empty-text">Carrinho vazio</div>
                    </div>
                `;
                updateCartTotals();
                return;
            }

            container.innerHTML = shoppingCart.map((item, idx) => `
                <div class="cart-entry">
                    <div class="entry-thumb">${item.emoji}</div>
                    <div class="entry-info">
                        <h4 class="entry-name">${item.name}</h4>
                        <p class="entry-extras">${item.customizations}</p>
                        <div class="entry-actions">
                            <div class="option-controls">
                                <button class="control-btn" onclick="changeCartQty(${idx}, -1)">−</button>
                                <span class="control-value">${item.qty}</span>
                                <button class="control-btn" onclick="changeCartQty(${idx}, 1)">+</button>
                            </div>
                            <button class="remove-btn" onclick="removeFromCart(${idx})">Remover</button>
                        </div>
                    </div>
                    <div class="entry-price">R$ ${(item.finalPrice * item.qty).toFixed(2)}</div>
                </div>
            `).join('');

            updateCartTotals();
        }

        // Alterar quantidade no carrinho
        function changeCartQty(index, delta) {
            if (shoppingCart[index].qty + delta < 1) {
                removeFromCart(index);
                return;
            }
            
            shoppingCart[index].qty += delta;
            renderCartItems();
            updateCartBadge();
            saveCartToStorage();
        }

        // Remover do carrinho
        function removeFromCart(index) {
            shoppingCart.splice(index, 1);
            renderCartItems();
            updateCartBadge();
            saveCartToStorage();
            
            // Remover promoção se carrinho ficar vazio
            if (shoppingCart.length === 0) {
                appliedPromo = null;
                document.getElementById('promoMessage').textContent = '';
                document.getElementById('promoCode').value = '';
            }
        }

        // Atualizar badge do carrinho
        function updateCartBadge() {
            const totalItems = shoppingCart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartCount').textContent = totalItems;
        }

        // Atualizar totais do carrinho
        function updateCartTotals() {
            const subtotal = shoppingCart.reduce((sum, item) => sum + (item.finalPrice * item.qty), 0);
            const deliveryFee = shoppingCart.length > 0 ? 8.00 : 0;
            
            // Aplicar promoção se existir
            let discount = 0;
            if (appliedPromo && appliedPromo.valid) {
                discount = appliedPromo.discount;
            }
            
            const total = Math.max(0, subtotal + deliveryFee - discount);

            document.getElementById('subtotalValue').textContent = `R$ ${subtotal.toFixed(2)}`;
            document.getElementById('deliveryFeeValue').textContent = `R$ ${deliveryFee.toFixed(2)}`;
            document.getElementById('totalValue').textContent = `R$ ${total.toFixed(2)}`;
            
            // Adicionar linha de desconto se houver promoção
            const totalsDiv = document.querySelector('.cart-totals');
            let discountRow = document.getElementById('discountRow');
            
            if (appliedPromo && appliedPromo.valid) {
                if (!discountRow) {
                    discountRow = document.createElement('div');
                    discountRow.id = 'discountRow';
                    discountRow.className = 'total-row';
                    discountRow.innerHTML = `<span>Desconto (${appliedPromo.promoName})</span> <span style="color: #E71D36;">- R$ ${discount.toFixed(2)}</span>`;
                    totalsDiv.insertBefore(discountRow, document.querySelector('.total-row.final'));
                } else {
                    discountRow.innerHTML = `<span>Desconto (${appliedPromo.promoName})</span> <span style="color: #E71D36;">- R$ ${discount.toFixed(2)}</span>`;
                }
            } else if (discountRow) {
                discountRow.remove();
            }
        }

        // Selecionar tipo de entrega
        function selectDelivery(type) {
            document.querySelectorAll('.delivery-choice').forEach(el => {
                el.classList.remove('selected');
            });
            document.querySelector(`[data-delivery="${type}"]`).classList.add('selected');
        }

        // Aplicar código promocional
        function applyPromoCode() {
            const promoCode = document.getElementById('promoCode').value.trim();
            const subtotal = shoppingCart.reduce((sum, item) => sum + (item.finalPrice * item.qty), 0);
            const deliveryFee = shoppingCart.length > 0 ? 8.00 : 0;
            const cartTotal = subtotal + deliveryFee;
            
            if (!promoCode) {
                document.getElementById('promoMessage').textContent = 'Digite um código promocional';
                document.getElementById('promoMessage').style.color = '#E71D36';
                return;
            }
            
            const result = promotions.applyPromo(promoCode, cartTotal);
            const messageEl = document.getElementById('promoMessage');
            
            if (result.valid) {
                appliedPromo = result;
                messageEl.textContent = `✓ Cupom aplicado! Desconto de R$ ${result.discount.toFixed(2)}`;
                messageEl.style.color = '#2EC4B6';
                updateCartTotals();
            } else {
                appliedPromo = null;
                messageEl.textContent = result.message;
                messageEl.style.color = '#E71D36';
                updateCartTotals();
            }
        }

        // Gerar código do pedido
        function generateOrderCode() {
            const date = new Date();
            const day = date.getDate().toString().padStart(2, '0');
            const hour = date.getHours().toString().padStart(2, '0');
            const random = Math.floor(Math.random() * 999).toString().padStart(3, '0');
            currentOrderCode = `P${day}${hour}${random}`;
            
            if (document.getElementById('orderCodeDisplay')) {
                document.getElementById('orderCodeDisplay').textContent = currentOrderCode;
            }
        }

        // Verificar horário de funcionamento
        function checkBusinessHours() {
            const config = window.elementSdk.config || defaultConfig;
            const now = new Date();
            const hour = now.getHours();
            const opening = config.opening_hour || 11;
            const closing = config.closing_hour || 23;
            
            if (hour < opening || hour >= closing) {
                return {
                    isOpen: false,
                    message: `Estamos fechados. Horário de funcionamento: ${opening}h às ${closing}h`
                };
            }
            
            return { isOpen: true };
        }

        // Atualizar lista de pedidos
        function refreshOrdersList(orders) {
            const container = document.getElementById('ordersContainer');
            
            if (!orders || orders.length === 0) {
                container.innerHTML = `
                    <div class="empty-view">
                        <div class="empty-icon">📦</div>
                        <div class="empty-text">Nenhum pedido registrado</div>
                    </div>
                `;
                return;
            }

            const sorted = [...orders].sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
            
            container.innerHTML = sorted.map((order, idx) => `
                <div class="order-row">
                    <div class="order-data">
                        <h4>Pedido #${order.order_code || (orders.length - idx)} - ${order.customer_name}</h4>
                        <p>${order.product_name} (${order.quantity}x)</p>
                        <p>${order.customizations || 'Sem personalizações'}</p>
                        <p><strong>Total: R$ ${order.total?.toFixed(2) || '0.00'}</strong></p>
                        <small>${new Date(order.timestamp).toLocaleString('pt-BR')}</small>
                    </div>
                    <span class="status-badge ${idx % 3 === 0 ? 'preparing' : idx % 3 === 1 ? 'delivering' : 'done'}">
                        ${idx % 3 === 0 ? 'Preparando' : idx % 3 === 1 ? 'Entregando' : 'Finalizado'}
                    </span>
                </div>
            `).join('');
        }

        // Atualizar dashboard
        function refreshDashboard(orders) {
            const today = new Date().toDateString();
            const todayOrders = orders.filter(o => new Date(o.timestamp).toDateString() === today);
            
            document.getElementById('statsOrders').textContent = todayOrders.length;

            const revenue = todayOrders.reduce((sum, o) => sum + (o.total || 0), 0);
            document.getElementById('statsRevenue').textContent = `R$ ${revenue.toFixed(0)}`;

            const average = todayOrders.length > 0 ? revenue / todayOrders.length : 0;
            document.getElementById('statsAverage').textContent = `R$ ${average.toFixed(0)}`;
            
            const uniqueCustomers = new Set(todayOrders.map(o => o.customer_phone || o.customer_name)).size;
            document.getElementById('statsCustomers').textContent = uniqueCustomers;
        }

        // Mostrar/ocultar loading
        function showLoading(show) {
            document.getElementById('loadingScreen').classList.toggle('visible', show);
        }

        // Salvar carrinho no localStorage
        function saveCartToStorage() {
            try {
                localStorage.setItem('shoppingCart', JSON.stringify(shoppingCart));
                localStorage.setItem('cartTimestamp', new Date().toISOString());
            } catch (e) {
                console.warn('Não foi possível salvar o carrinho:', e);
            }
        }

        // Carregar carrinho do localStorage
        function loadCartFromStorage() {
            try {
                const saved = localStorage.getItem('shoppingCart');
                const timestamp = localStorage.getItem('cartTimestamp');
                
                if (saved && timestamp) {
                    const savedTime = new Date(timestamp);
                    const now = new Date();
                    const hoursDiff = (now - savedTime) / (1000 * 60 * 60);
                    
                    // Manter carrinho por até 24 horas
                    if (hoursDiff < 24) {
                        shoppingCart = JSON.parse(saved);
                        updateCartBadge();
                    }
                }
            } catch (e) {
                console.warn('Não foi possível carregar o carrinho:', e);
            }
        }

        // Salvar dados do formulário
        function saveFormData() {
            const formData = {
                custName: document.getElementById('custName').value,
                custPhone: document.getElementById('custPhone').value,
                custAddress: document.getElementById('custAddress').value,
                paymentMethod: document.getElementById('paymentMethod').value
            };
            
            try {
                localStorage.setItem('formData', JSON.stringify(formData));
            } catch (e) {
                console.warn('Não foi possível salvar o formulário:', e);
            }
        }

        // Carregar dados do formulário
        function loadSavedForm() {
            try {
                const saved = localStorage.getItem('formData');
                if (saved) {
                    const formData = JSON.parse(saved);
                    document.getElementById('custName').value = formData.custName || '';
                    document.getElementById('custPhone').value = formData.custPhone || '';
                    document.getElementById('custAddress').value = formData.custAddress || '';
                    document.getElementById('paymentMethod').value = formData.paymentMethod || '';
                }
            } catch (e) {
                console.warn('Não foi possível carregar o formulário:', e);
            }
        }

        // Configurar event listeners
        function setupEventListeners() {
            // Navegação
            document.querySelectorAll('.nav-link').forEach(link => {
                link.addEventListener('click', () => {
                    navigateTo(link.dataset.view);
                });
            });
            
            // Feedback tátil em botões
            document.addEventListener('click', function(e) {
                if (e.target.matches('.product-action, .hero-cta, .final-action, .control-btn')) {
                    e.target.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        e.target.style.transform = '';
                    }, 150);
                }
            });
            
            // Auto-salvar formulário
            const formFields = ['custName', 'custPhone', 'custAddress', 'paymentMethod', 'changeAmount', 'orderNotes'];
            formFields.forEach(id => {
                const field = document.getElementById(id);
                if (field) {
                    field.addEventListener('input', function() {
                        saveFormData();
                    });
                }
            });
        }

        // Inicializar quando o DOM estiver pronto
        document.addEventListener('DOMContentLoaded', initializeApp);
    </script>
</body>
</html>
