                initTheme();
                
                // Carregar carrinho do localStorage
                loadCartFromStorage();
                
                // Configurar evento do formulário de checkout
                const checkoutForm = document.getElementById('checkoutForm');
                if (checkoutForm) {
                    checkoutForm.addEventListener('submit', handleCheckout);
                } else {
                    console.error("Formulário de checkout não encontrado!");
                }
                
                // Inicializar SDKs
                const dataHandler = {
                    onDataChanged(data) {
                        refreshOrdersList(data);
                        refreshDashboard(data);
                    }
                };

                const initResult = await window.dataSdk.init(dataHandler);
                if (!initResult.isOk) {
                    console.warn("SDK initialization had issues");
                }

                await window.elementSdk.init({
                    defaultConfig,
                    onConfigChange: updateUIWithConfig,
                    mapToCapabilities,
                    mapToEditPanelValues
                });

                updateUIWithConfig(window.elementSdk.config);
                
                // Configurar outros eventos
                setupEventListeners();
                
                // Carregar formulário salvo
                loadSavedForm();
                
                console.log("Aplicação inicializada com sucesso!");
            } catch (error) {
                console.error("Erro na inicialização:", error);
            }
        }

