        .confirm-heading {
            font-size: 40px;
            font-weight: 900;
            margin-bottom: 20px;
            background: var(--success-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

