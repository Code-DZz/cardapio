<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cardápio Digital Premium - Lanchonete WhatsApp</title>
    <script src="/_sdk/data_sdk.js"></script>
    <script src="/_sdk/element_sdk.js"></script>
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #FF6B35 0%, #FF9F1C 100%);
            --secondary-gradient: linear-gradient(135deg, #2EC4B6 0%, #20A39E 100%);
            --accent-gradient: linear-gradient(135deg, #E71D36 0%, #FF9F1C 100%);
            --success-gradient: linear-gradient(135deg, #2EC4B6 0%, #20A39E 100%);
            --dark-bg: #0A0F1C;
            --dark-surface: #1A2238;
            --dark-text: #E2E8F0;
            --light-bg: #F8FAFC;
            --light-surface: #FFFFFF;
            --light-text: #1E293B;
            --shadow-color: rgba(0, 0, 0, 0.1);
            --border-color: #E2E8F0;
            --card-shadow: 0 8px 32px rgba(255, 107, 53, 0.15);
            --hover-shadow: 0 16px 48px rgba(255, 107, 53, 0.25);
            --transition-speed: 0.3s;
        }

        /* Botão de Tema no Header */
        .theme-switcher {
            background: transparent;
            border: none;
            font-size: 24px;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: all 0.3s ease;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .theme-switcher:hover {
            background: rgba(255, 107, 53, 0.1);
            transform: rotate(30deg);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--light-bg);
            color: var(--light-text);
            transition: all var(--transition-speed) ease;
            overflow-x: hidden;
        }

        body.dark-mode {
            background: var(--dark-bg);
            color: var(--dark-text);
        }

        .main-wrapper {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* Sidebar Moderna */
        .navigation-sidebar {
            width: 280px;
            background: var(--light-surface);
            border-right: 1px solid var(--border-color);
            position: fixed;
            height: 100%;
            display: flex;
            flex-direction: column;
            z-index: 1000;
            transition: all var(--transition-speed) ease;
        }

        body.dark-mode .navigation-sidebar {
            background: var(--dark-surface);
            border-right-color: rgba(255, 255, 255, 0.1);
        }

        .sidebar-brand {
            padding: 28px 24px;
            border-bottom: 1px solid var(--border-color);
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        body.dark-mode .sidebar-brand {
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }

        .brand-logo {
            font-size: 42px;
            margin-bottom: 12px;
            display: block;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .brand-name {
            font-size: 24px;
            font-weight: 800;
            margin: 0 0 4px;
            letter-spacing: -0.5px;
        }

        .brand-subtitle {
            font-size: 13px;
            opacity: 0.8;
            font-weight: 500;
        }

        .nav-menu {
            flex: 1;
            padding: 24px 16px;
            overflow-y: auto;
        }

        .nav-section-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 24px 12px 12px;
            opacity: 0.6;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 14px 16px;
            margin-bottom: 8px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s ease;
            text-decoration: none;
            font-weight: 600;
            color: var(--light-text);
            position: relative;
            overflow: hidden;
        }

        body.dark-mode .nav-link {
            color: var(--dark-text);
        }

        .nav-link:hover {
            background: rgba(255, 107, 53, 0.1);
            transform: translateX(4px);
        }

        .nav-link.active {
            background: var(--primary-gradient);
            color: white;
            box-shadow: 0 4px 20px rgba(255, 107, 53, 0.3);
        }

        .nav-icon {
            font-size: 20px;
            margin-right: 12px;
            width: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Theme Toggle na Sidebar (opcional) */
        .theme-toggle {
            padding: 16px 24px;
            border-top: 1px solid var(--border-color);
        }

        body.dark-mode .theme-toggle {
            border-top-color: rgba(255, 255, 255, 0.1);
        }

        /* Content Area */
        .content-area {
            margin-left: 280px;
            flex: 1;
            min-height: 100vh;
            transition: all var(--transition-speed) ease;
        }

        /* Header com botão de tema */
        .content-header {
            background: var(--light-surface);
            border-bottom: 1px solid var(--border-color);
            padding: 24px 40px;
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        body.dark-mode .content-header {
            background: rgba(26, 34, 56, 0.9);
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 32px;
            font-weight: 800;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
        }

        .page-subtitle {
            font-size: 15px;
            opacity: 0.8;
            margin-top: 4px;
        }

        .header-actions {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .cart-badge {
            position: relative;
            cursor: pointer;
            background: var(--primary-gradient);
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .cart-badge:hover {
            transform: scale(1.1) rotate(5deg);
            box-shadow: 0 8px 24px rgba(255, 107, 53, 0.3);
        }

        .cart-icon {
            font-size: 24px;
            color: white;
        }

        .badge-count {
            position: absolute;
            top: -6px;
            right: -6px;
            background: var(--accent-gradient);
            color: white;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 800;
            border: 2px solid var(--light-surface);
        }

        body.dark-mode .badge-count {
            border-color: var(--dark-surface);
        }

        /* View Container */
        .view-container {
            display: none;
            animation: fadeInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .view-container.active {
            display: block;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Hero Section */
        .hero-section {
            background: var(--light-surface);
            border-radius: 24px;
            padding: 80px 60px;
            text-align: center;
            margin: 40px;
            border: 1px solid var(--border-color);
            position: relative;
            overflow: hidden;
        }

        body.dark-mode .hero-section {
            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: var(--primary-gradient);
        }

        .hero-icon {
            font-size: 96px;
            margin-bottom: 32px;
            animation: float 3s ease-in-out infinite;
            display: block;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-20px); }
        }

        .hero-title {
            font-size: 56px;
            font-weight: 900;
            margin: 0 0 20px;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.1;
        }

        .hero-description {
            font-size: 18px;
            opacity: 0.8;
            max-width: 500px;
            margin: 0 auto 40px;
            line-height: 1.6;
        }

        .hero-cta {
            background: var(--primary-gradient);
            color: white;
            border: none;
            padding: 20px 56px;
            border-radius: 16px;
            font-size: 18px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            position: relative;
            overflow: hidden;
        }

        .hero-cta:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(255, 107, 53, 0.4);
        }

        .hero-cta::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }

        .hero-cta:hover::after {
            width: 300px;
            height: 300px;
        }

        /* Categories Grid */
        .categories-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 32px;
            margin: 40px;
        }

        .category-item {
            background: var(--light-surface);
            border-radius: 20px;
            padding: 40px 32px;
            text-align: center;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
        }

        body.dark-mode .category-item {
            background: var(--dark-surface);
        }

        .category-item:hover {
            transform: translateY(-12px);
            border-color: var(--primary-gradient);
            box-shadow: var(--hover-shadow);
        }

        .category-emoji {
            font-size: 64px;
            margin-bottom: 20px;
            display: block;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }

        .category-title {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 8px;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .category-count {
            font-size: 14px;
            opacity: 0.7;
            font-weight: 500;
        }

        /* Products Grid */
        .products-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 32px;
            margin: 40px;
        }

        .product-item {
            background: var(--light-surface);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid var(--border-color);
            position: relative;
        }

        body.dark-mode .product-item {
            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .product-item:hover {
            transform: translateY(-12px) scale(1.02);
            box-shadow: var(--hover-shadow);
        }

        .product-thumb {
            height: 240px;
            background: var(--secondary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        .product-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            background: var(--accent-gradient);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .product-details {
            padding: 28px;
        }

        .product-title {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 12px;
            color: var(--light-text);
        }

        body.dark-mode .product-title {
            color: var(--dark-text);
        }

        .product-text {
            font-size: 15px;
            opacity: 0.8;
            margin-bottom: 24px;
            line-height: 1.6;
        }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-cost {
            font-size: 32px;
            font-weight: 900;
            background: var(--success-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .product-action {
            background: var(--primary-gradient);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .product-action:hover {
            transform: scale(1.05);
            box-shadow: 0 8px 24px rgba(255, 107, 53, 0.3);
        }

        /* Customization View */
        .customization-wrapper {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px;
        }

        .back-nav {
            background: var(--light-surface);
            color: var(--light-text);
            border: 2px solid var(--border-color);
            padding: 14px 28px;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 32px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        body.dark-mode .back-nav {
            background: var(--dark-surface);
            color: var(--dark-text);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .back-nav:hover {
            border-color: var(--primary-gradient);
            transform: translateX(-4px);
        }

        .product-showcase {
            background: var(--light-surface);
            border-radius: 24px;
            overflow: hidden;
            margin-bottom: 32px;
            border: 1px solid var(--border-color);
        }

        body.dark-mode .product-showcase {
            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .showcase-image {
            height: 400px;
            background: var(--secondary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .showcase-info {
            padding: 40px;
        }

        .showcase-title {
            font-size: 42px;
            font-weight: 900;
            margin-bottom: 16px;
            color: var(--light-text);
        }

        body.dark-mode .showcase-title {
            color: var(--dark-text);
        }

        .showcase-description {
            font-size: 17px;
            opacity: 0.8;
            margin-bottom: 32px;
            line-height: 1.7;
        }

        .showcase-price {
            font-size: 48px;
            font-weight: 900;
            background: var(--success-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .customization-block {
            background: var(--light-surface);
            border-radius: 20px;
            padding: 32px;
            margin-bottom: 24px;
            border: 1px solid var(--border-color);
        }

        body.dark-mode .customization-block {
            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .block-header {
            font-size: 22px;
            font-weight: 800;
            margin-bottom: 28px;
            padding-bottom: 16px;
            border-bottom: 2px solid var(--border-color);
            color: var(--light-text);
        }

        body.dark-mode .block-header {
            color: var(--dark-text);
            border-bottom-color: rgba(255, 255, 255, 0.1);
        }

        .custom-option {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        body.dark-mode .custom-option {
            border-bottom-color: rgba(255, 255, 255, 0.05);
        }

        .custom-option:last-child {
            border-bottom: none;
        }

        .option-details {
            flex: 1;
        }

        .option-label {
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 6px;
            color: var(--light-text);
        }

        body.dark-mode .option-label {
            color: var(--dark-text);
        }

        .option-cost {
            font-size: 16px;
            background: var(--success-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
        }

        .option-controls {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .control-btn {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            border: 2px solid var(--border-color);
            background: var(--light-surface);
            color: var(--light-text);
            font-size: 24px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        body.dark-mode .control-btn {
            background: var(--dark-surface);
            color: var(--dark-text);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .control-btn:hover {
            border-color: var(--primary-gradient);
            background: var(--primary-gradient);
            color: white;
            transform: scale(1.1);
        }

        .control-value {
            font-size: 20px;
            font-weight: 800;
            min-width: 40px;
            text-align: center;
            color: var(--light-text);
        }

        body.dark-mode .control-value {
            color: var(--dark-text);
        }

        .size-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .size-choice {
            padding: 24px;
            border: 2px solid var(--border-color);
            border-radius: 16px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: var(--light-surface);
            font-weight: 700;
            font-size: 16px;
            color: var(--light-text);
        }

        body.dark-mode .size-choice {
            background: var(--dark-surface);
            color: var(--dark-text);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .size-choice:hover {
            border-color: var(--primary-gradient);
            transform: translateY(-4px);
        }

        .size-choice.selected {
            background: var(--primary-gradient);
            color: white;
            border-color: transparent;
            box-shadow: 0 8px 24px rgba(255, 107, 53, 0.3);
        }

        .final-action {
            width: 100%;
            background: var(--primary-gradient);
            color: white;
            border: none;
            padding: 24px;
            border-radius: 16px;
            font-size: 20px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 40px;
            position: relative;
            overflow: hidden;
        }

        .final-action:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 60px rgba(255, 107, 53, 0.4);
        }

        .final-action:active {
            transform: translateY(-2px);
        }

        /* Cart View */
        .cart-wrapper {
            max-width: 1000px;
            margin: 0 auto;
            padding: 40px;
        }

        .cart-list {
            background: var(--light-surface);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 32px;
            border: 1px solid var(--border-color);
        }

        body.dark-mode .cart-list {
            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .cart-entry {
            display: flex;
            gap: 24px;
            padding: 28px 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        body.dark-mode .cart-entry {
            border-bottom-color: rgba(255, 255, 255, 0.05);
        }

        .cart-entry:last-child {
            border-bottom: none;
        }

        .entry-thumb {
            width: 120px;
            height: 120px;
            border-radius: 16px;
            background: var(--secondary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 48px;
            flex-shrink: 0;
        }

        .entry-info {
            flex: 1;
        }

        .entry-name {
            font-size: 20px;
            font-weight: 800;
            margin-bottom: 12px;
            color: var(--light-text);
        }

        body.dark-mode .entry-name {
            color: var(--dark-text);
        }

        .entry-extras {
            font-size: 14px;
            opacity: 0.8;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .entry-actions {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .remove-btn {
            background: rgba(231, 29, 54, 0.1);
            border: 2px solid transparent;
            color: #E71D36;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            padding: 10px 20px;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .remove-btn:hover {
            background: rgba(231, 29, 54, 0.2);
            border-color: #E71D36;
            transform: scale(1.05);
        }

        .entry-price {
            font-size: 28px;
            font-weight: 900;
            background: var(--success-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            align-self: flex-start;
        }

        .cart-totals {
            background: var(--light-surface);
            border-radius: 24px;
            padding: 32px;
            border: 1px solid var(--border-color);
        }

        body.dark-mode .cart-totals {
            background: var(--dark-surface);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
            font-size: 18px;
            color: var(--light-text);
            padding-bottom: 12px;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        body.dark-mode .total-row {
            color: var(--dark-text);
            border-bottom-color: rgba(255, 255, 255, 0.05);
        }

        .total-row.final {
            font-size: 36px;
            font-weight: 900;
            background: var(--success-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
